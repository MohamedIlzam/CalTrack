# CalTrack Backend Environment Configuration Example
# Copy this file to .env and adjust the variables for your local or cloud environment.

# Server Port
PORT=3001

# PostgreSQL connection string with pgvector extension support
# Default local Docker Compose uses port 5433 to prevent collision with native Postgres on 5432.
# Note: If your password contains special characters like '@', '#', or '$', URL-encode them.
# Example: Password123@#$ -> Password123%40%23%24
# In production, this must point to your managed PostgreSQL instance (e.g., Neon).
DATABASE_URL="postgresql://postgres:your_local_password@localhost:5433/caltrack?schema=public"
# Direct (non-pooler) connection used only by Prisma migration/seed commands.
# For local PostgreSQL this can equal DATABASE_URL. For Neon use the direct host.
DIRECT_DATABASE_URL="postgresql://postgres:your_local_password@localhost:5433/caltrack?schema=public"

# Redis Connection URL
# Used for fixed-window rate limiting on AI endpoints (15 req/min) and food search caching
# In production, use Upstash TLS URL (rediss://default:***@us1-xyz.upstash.io:6379)
REDIS_URL="redis://localhost:6379"

# JWT Secret for Authenticated Sessions
# REQUIRED in production: Must be a cryptographically strong string of at least 32 characters.
# Generate via: openssl rand -base64 32
JWT_SECRET="generate-a-strong-secret-key-at-least-32-characters-long"

# Allowed Frontend Origins for CORS
# In production, specify your deployed frontend origin(s), comma-separated (e.g. https://caltrack.vercel.app).
# REQUIRED in production mode (NODE_ENV=production). Wildcards are not allowed.
FRONTEND_URL="http://localhost:3000"

# Google Gemini API Configuration (CalTrack Intelligence Engine)
# Optional for local test suites (tests use synthetic mocks), required for live AI Coach inference.
GEMINI_API_KEY=""
# Primary Gemini model (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"
# Supported fallback Gemini model for 503 high-demand retries (defaults to gemini-flash-lite-latest)
GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"
# PERSONALIZED GEMINI IS OFF BY DEFAULT. Enable only after the operator has
# verified an eligible paid Gemini configuration and applicable data-processing terms.
GEMINI_PERSONALIZED_DATA_ENABLED="false"
# Set this exact value only after completing that external operator review.
GEMINI_PERSONALIZED_OPERATOR_CONFIRMATION=""
